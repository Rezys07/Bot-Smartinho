# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# IDs opcionais: se vazios, o bot procura pelo nome (e `bun run setup` cria se faltar)
ROLE_PARTICIPANTE_ID=
ROLE_MENTOR_ID=
ROLE_ORGANIZACAO_ID=
CHANNEL_CHECKIN_ID=
CHANNEL_FILA_MENTORIA_ID=
CHANNEL_BOT_LOGS_ID=

# ─── Google Sheets (Service Account, somente leitura) ───────
GOOGLE_SHEET_ID=
# Nome da aba (pode incluir intervalo, ex.: "Respostas ao formulário 1!A:K")
GOOGLE_SHEET_RANGE=Respostas ao formulário 1
# Conteúdo do JSON da chave em base64 (base64 -w0 chave.json)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Intervalo de atualização do cache da planilha, em minutos
SHEETS_REFRESH_MINUTES=5

# ─── Regras do evento ───────────────────────────────────────
TEAM_MAX_SIZE=5
TEAMS_PER_CATEGORY=25
# Prazo para alterar o desafio (ISO 8601, com fuso). Vazio = sem prazo
DESAFIO_PRAZO=
# Minutos sem atendimento antes de avisar a organização
MENTORIA_ALERTA_MINUTOS=15
# Anti-enumeração do !entrar
CHECKIN_MAX_TENTATIVAS=5
CHECKIN_JANELA_MINUTOS=15

# ─── Infra ──────────────────────────────────────────────────
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
