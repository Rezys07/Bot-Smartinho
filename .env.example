# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# IDs opcionais: se vazios, o bot procura pelo nome (e `bun run setup` cria se faltar)
# Cargo dado no check-in (padrão: "Convidado")
ROLE_PARTICIPANTE_ID=
ROLE_MENTOR_ID=
ROLE_ORGANIZACAO_ID=
CHANNEL_CHECKIN_ID=
CHANNEL_FILA_MENTORIA_ID=
CHANNEL_BOT_LOGS_ID=

# ─── Google Sheets (Service Account, somente leitura) ───────
GOOGLE_SHEET_ID=
# Nome da aba (pode incluir intervalo, ex.: "Página1!A:C")
GOOGLE_SHEET_RANGE=Página1
# Credenciais: "client_email" e "private_key" do JSON da chave
# (a chave entre aspas duplas, mantendo os \n). Preencha só no .env, nunca aqui.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Alternativa às duas acima: o JSON inteiro em base64 (base64 -w0 chave.json)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Planilha de mentores/organização (colunas: Nome, usuário, Qual hackathon).
# Quem estiver nela recebe Mentor ao entrar no servidor, sem check-in. Vazio = desligado.
STAFF_SHEET_ID=
STAFF_SHEET_RANGE=Página1
# Formato da planilha de inscrições: "simples" (Nome, E-mail/Usuário, Equipe) ou
# "times" (aba em grade TEAM 01, TEAM 02… cruzada pelo nome com as respostas do formulário)
SHEET_FORMAT=simples
TEAMS_RANGE=Teams
DIRECTORY_RANGE=Respostas ao formulário 1
# Intervalo de atualização do cache da planilha, em minutos
SHEETS_REFRESH_MINUTES=5

# ─── Regras do evento ───────────────────────────────────────
TEAM_MAX_SIZE=5
TEAMS_PER_CATEGORY=25
# Criar os canais de TODAS as equipes da planilha antes do check-in (senão, cria no 1º check-in da equipe)
CRIAR_EQUIPES_ANTECIPADO=false
# Equipes vindas da planilha aceitam individuais até completar TEAM_MAX_SIZE?
EQUIPES_PLANILHA_ABERTAS=false
# Prazo para alterar o desafio (ISO 8601, com fuso). Vazio = sem prazo
DESAFIO_PRAZO=
# Minutos sem atendimento antes de avisar a organização
MENTORIA_ALERTA_MINUTOS=15
# Segundos até apagar o aviso "Fulano entrou no servidor" (0 = não apagar)
APAGAR_AVISO_ENTRADA_SEGUNDOS=5
# Anti-enumeração do !entrar
CHECKIN_MAX_TENTATIVAS=5
CHECKIN_JANELA_MINUTOS=15

# Usuários do Discord da planilha de staff que recebem Organização (os demais recebem Mentor)
ORGANIZACAO_USUARIOS=
# Usuários do Discord que recebem Mentor mesmo fora da planilha de staff (separados por vírgula)
MENTOR_USUARIOS=
# Filtra a coluna "Qual hackathon" (vazio = todos; "Os dois" sempre entra). Ex.: Cidades inteligentes
STAFF_HACKATHONS=

# ─── Infra ──────────────────────────────────────────────────
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
